.venv/
ollama_storage/
# hermes_files/
hermes_files/ai_files

__pycache__/


# Ignore everything under data
hermes_files/data/**
# Allow skills tree
!hermes_files/data/skills/
!hermes_files/data/skills/**
# Ignore Hermes skill manager metadata
hermes_files/data/skills/.hub/
hermes_files/data/skills/.usage.json

# Re-ignore Python cache under skills
hermes_files/data/skills/**/__pycache__/
hermes_files/data/skills/.curator_state
hermes_files/data/skills/.usage.json



# Allow memories tree
!hermes_files/data/memories/
!hermes_files/data/memories/**

# Allow cron/watchdog scripts tree
!hermes_files/data/scripts/
!hermes_files/data/scripts/**

# Allow cron job definitions (not execution history/locks/heartbeats)
!hermes_files/data/cron/
!hermes_files/data/cron/jobs.json
